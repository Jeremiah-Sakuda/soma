{
  "name": "soma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "check:meta": "node --env-file=.env.local scripts/check-meta.mjs",
    "check:firestore": "node --env-file=.env.local scripts/check-firestore.mjs",
    "check:config": "node --experimental-strip-types --env-file=.env.local scripts/check-production-config.mjs",
    "credentials:rotate": "node --experimental-strip-types --env-file=.env.local scripts/rotate-connector-key.mjs",
    "check:browser-artifact": "node scripts/check-browser-artifact.mjs --next-trace",
    "format": "prettier --write \"{src,desktop,services,scripts,tests,docs/examples}/**/*.{ts,tsx,js,jsx,mjs,cjs,css,html}\" next.config.ts playwright.config.ts vitest.config.ts postcss.config.mjs package.json desktop/package.json \"services/*/package.json\" .prettierrc.json \"public/*.js\"",
    "format:check": "prettier --check \"{src,desktop,services,scripts,tests,docs/examples}/**/*.{ts,tsx,js,jsx,mjs,cjs,css,html}\" next.config.ts playwright.config.ts vitest.config.ts postcss.config.mjs package.json desktop/package.json \"services/*/package.json\" .prettierrc.json \"public/*.js\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "three": "0.187.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "rimraf": "6.1.4"
  }
}
