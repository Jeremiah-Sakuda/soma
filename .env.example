# Soma local configuration. Copy to .env.local and fill values there.
# Never commit filled credentials. Empty values mean not configured.
# Provider contracts are documented in docs/LOCAL_SETUP.md.

# 1. Meta runtime inference (server/worker only)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3

# 2. Firebase / Firestore
# Keep local-synthetic until a Firestore connection has been verified.
SOMA_PERSISTENCE=local-synthetic
FIREBASE_PROJECT_ID=
# Absolute path to a service-account JSON OUTSIDE the repository.
# Leave empty when using Application Default Credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel: encrypted server-only environment value; do not set NEXT_PUBLIC_.
# Use either this JSON value or ADC, never a local path on a hosted deployment.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase web app configuration (public identifiers, not admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Live runtime calls require explicit application budgets before activation.
SOMA_LIVE_INFERENCE=false
META_ALLOCATION_USD=
META_APP_SPEND_CAP_USD=1

# 3. Trigger.dev development environment (server/worker only)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# 4. Browserbase (server/worker only)
BROWSERBASE_API_KEY=
# Optional explicit project selection; current API can infer the project.
BROWSERBASE_PROJECT_ID=

# Keep deployment CLI authentication outside this application file.
# Course email OAuth and LMS login will be configured separately.
