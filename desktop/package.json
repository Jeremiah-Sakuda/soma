{
  "name": "soma-desktop",
  "productName": "Soma",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "package": "electron-packager . Soma --platform=darwin --arch=arm64 --out=../.local/desktop-dist --overwrite --asar --app-bundle-id=app.soma.desktop --extend-info=Info.plist --ignore=^/test --ignore=^/README.md",
    "test:hosted": "node test/hosted.cjs",
    "release": "node release.cjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "electron": "45.1.0"
  }
}
