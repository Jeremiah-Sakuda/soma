# Soma local configuration. Copy to .env.local and fill values there.
# Never commit filled credentials. Empty values mean not configured.
# Provider contracts are documented in docs/LOCAL_SETUP.md.

# 1. Meta runtime inference (server/worker only)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
# Optional author/challenger workflow; same key, Wonder Standard pricing and shared limits.
# Keep false until model access and the new flow are verified in your environment.
SOMA_LESSON_REVIEW_ENABLED=false

# 2. Firebase / Firestore
# Keep local-synthetic until a Firestore connection has been verified.
SOMA_PERSISTENCE=local-synthetic
FIREBASE_PROJECT_ID=
# Absolute path to a service-account JSON OUTSIDE the repository.
# Leave empty when using Application Default Credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel: encrypted server-only environment value; do not set NEXT_PUBLIC_.
# Use either this JSON value or ADC, never a local path on a hosted deployment.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase web app configuration (public identifiers, not admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Live runtime calls require explicit application budgets before activation.
SOMA_LIVE_INFERENCE=false
META_ALLOCATION_USD=
META_APP_SPEND_CAP_USD=1
# Concurrent exploration leases, 1–16; invalid values use 4. Does not raise spend.
SOMA_EXPLORATION_MAX_ACTIVE=4

# 3. Trigger.dev development environment (server/worker only)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# 4. Browserbase (server/worker only)
BROWSERBASE_API_KEY=
# Optional explicit project selection; current API can infer the project.
BROWSERBASE_PROJECT_ID=

# Keep deployment CLI authentication outside this application file.
# Course email OAuth and LMS login will be configured separately.

# Read-only source connectors (server only)
SOMA_APP_URL=https://soma-woad-beta.vercel.app
# 32 random bytes encoded as 64 hex characters. Follow docs/CREDENTIAL_KEY_ROTATION.md.
SOMA_CONNECTOR_ENCRYPTION_KEY=
# Defaults preserve existing writes until compatible readers are deployed everywhere.
SOMA_CONNECTOR_ENCRYPTION_KEY_ID=legacy
SOMA_CONNECTOR_WRITE_FORMAT=v1
# JSON object of additional read keys (maximum four). Never commit filled values.
SOMA_CONNECTOR_DECRYPTION_KEYS={}
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Durable background worker (server only; scheduler uses the same secret).
SOMA_WORKER_ENABLED=false
SOMA_WORKER_SECRET=

# Browser hosting migration; legacy Browserbase key is retained for context cleanup.
SOMA_BROWSER_BACKEND=browserbase
SOMA_GCP_BROWSER_URL=
SOMA_GCP_BROWSER_PROJECT_ID=
SOMA_GCP_BROWSER_CONTROL_KEY=
# Runner-only values belong in Secret Manager / Cloud Run, not the Vercel app.
# SOMA_GCP_BROWSER_STATE_KEY=
# SOMA_GCP_BROWSER_BUCKET=

# Optional isolated institutional credential autofill; disabled until its deployment gates pass.
SOMA_CREDENTIAL_AUTOFILL_ENABLED=false
SOMA_CREDENTIAL_RUNNER_URL=
SOMA_CREDENTIAL_RUNNER_CONTROL_KEY=
SOMA_CREDENTIAL_AUTHORIZATION_KEY=
# Vault bucket, KMS key and browser-state decryption stay on the login-only worker.
# See docs/CREDENTIAL_AUTOFILL_DEPLOYMENT.md.

# Optional rollout gate; leave UNSET for normal multi-account availability.
# A present empty/malformed list blocks setup; cleanup remains available.
# SOMA_CREDENTIAL_AUTOFILL_ALLOWED_UIDS=

# Gemini TTS uses the existing Firebase project credentials, with Vertex AI enabled.
# Shares the existing application spend ledger/cap; no public API key.
SOMA_GEMINI_TTS=false

# Targeted advisory review for weighted and prediction-driven visual revisions
SOMA_EXPLORATION_REVIEW_ENABLED=false

# Optional authenticated Muse transcription relay; no provider credential reaches the client.
SOMA_VOICE_STREAM_URL=
SOMA_VOICE_CONTROL_KEY=
