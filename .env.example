# Soma local configuration. Copy to .env.local and fill values there.
# Never commit filled credentials. Empty values mean not configured.
# Provider contracts are documented in docs/LOCAL_SETUP.md.

# 1. Meta runtime inference (server/worker only)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3

# 2. Supabase project
# URL and publishable key are browser-safe; secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 3. Trigger.dev development environment (server/worker only)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# 4. Browserbase (server/worker only)
BROWSERBASE_API_KEY=
# Optional explicit project selection; current API can infer the project.
BROWSERBASE_PROJECT_ID=

# Keep deployment CLI authentication outside this application file.
# Course email OAuth and LMS login will be configured separately.
